# Copy this file to .env in the same folder, then fill in your key.
#   cp middle-tier-api/app/.env.example middle-tier-api/app/.env

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Optional. Any chat model that supports JSON mode.
OPENAI_MODEL=gpt-4o-mini

# Set automatically by docker compose. Only needed if you run uvicorn yourself.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=SyllaSync_LocalDB

# Browsers block requests from origins not listed here.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
